# Automatic HTTPS for every host in ZARQA_DOMAIN (comma-separated), e.g.
#   ZARQA_DOMAIN=tryzarqa.com, 173-249-40-122.sslip.io
{$ZARQA_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=()"
	}
}

# One canonical address: sign-in cookies belong to a single host.
www.tryzarqa.com {
	redir https://tryzarqa.com{uri} permanent
}
