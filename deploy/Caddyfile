# Automatic HTTPS for every host in ZARQA_DOMAIN (comma-separated), e.g.
#   ZARQA_DOMAIN=tryzarqa.com, 173-249-40-122.sslip.io
{$ZARQA_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=()"
		# Nothing may frame the app (clickjacking), and only its own files may run. Checked against every screen
		# of the production build with no violations; React sets inline styles through the DOM, which this allows.
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}

# One canonical address: sign-in cookies belong to a single host.
www.tryzarqa.com {
	redir https://tryzarqa.com{uri} permanent
}

# Uni Schedule (separate app, container uni-schedule on the zarqa_default network; see the Schedule repo deploy/).
schedule.tryzarqa.com, schedule.173-249-40-122.sslip.io {
	encode gzip
	reverse_proxy uni-schedule:8080
}

# >>> zoor
# Managed by the Zoor repo (deploy/Caddyfile.snippet). deploy/deploy.sh writes this block into
# /opt/zarqa/deploy/Caddyfile; keep the copy in Zarqa's repo (LostraAi deploy/Caddyfile) the same.
zoor.173-249-40-122.sslip.io {
	encode zstd gzip
	reverse_proxy zoor:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
# <<< zoor
