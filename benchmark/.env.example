# Simplest setup: one OpenRouter key runs everything
# (Jev as typesafe/jev-1.13, Luna as openai/gpt-6-luna, embeddings as openai/text-embedding-3-small).
OPENROUTER_API_KEY=

# Optional: use these providers directly instead.
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Optional: any other OpenAI-compatible endpoint, and model names it uses.
OPENAI_BASE_URL=
LUNA_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
